{
  "expo": {
    "name": "ChocaFácil",
    "slug": "chocafacil-offline",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "chocafacil",
    "android": {
      "package": "com.depaulasystems.chocafacil",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o ChocaFácil acesse suas fotos para cadastrar a imagem da galinha.",
          "cameraPermission": "Permita que o ChocaFácil use a câmera para fotografar a galinha."
        }
      ],
      "expo-notifications",
      "expo-sqlite"
    ],
    "extra": {
      "offlineOnly": true,
      "eas": {
        "projectId": "74665e4c-05cd-4d39-84f2-39b7951a832a"
      }
    }
  }
}
